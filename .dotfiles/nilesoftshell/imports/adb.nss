menu(where=!wnd.is_desktop mode="multiple" type='file|dir' title='ADB' image=svg_android)
{
	item(find='.apk' mode="single" title='Install APK' cmd-ps=`$rows = adb devices | Select-Object -Skip 1 | ForEach-Object { $_.Trim() } | Where-Object { $_ }; $ids = $rows | ForEach-Object { if($_ -match '^(?<id>\S+)\s+device$'){ $matches.id } }; $device = $ids | Where-Object { $_ -match '^\d+\.\d+\.\d+\.\d+:\d+$' } | Select-Object -First 1; if(-not $device){ $device = $ids | Select-Object -First 1 }; if(-not $device){ throw 'No ADB device connected' }; adb -s $device install -r -t '@sel.path'`)
	item(find='.apk' where=sel.count>1 title='Install Multiple APKs' cmd-ps=`$rows = adb devices | Select-Object -Skip 1 | ForEach-Object { $_.Trim() } | Where-Object { $_ }; $ids = $rows | ForEach-Object { if($_ -match '^(?<id>\S+)\s+device$'){ $matches.id } }; $device = $ids | Where-Object { $_ -match '^\d+\.\d+\.\d+\.\d+:\d+$' } | Select-Object -First 1; if(-not $device){ $device = $ids | Select-Object -First 1 }; if(-not $device){ throw 'No ADB device connected' }; $paths = '@sel(false, "|")'; $paths.Split('|') | ForEach-Object { if($_.Trim()) { adb -s $device install -r -t $_ } }`)
	item(title='Push to Downloads' cmd-ps=`$rows = adb devices | Select-Object -Skip 1 | ForEach-Object { $_.Trim() } | Where-Object { $_ }; $ids = $rows | ForEach-Object { if($_ -match '^(?<id>\S+)\s+device$'){ $matches.id } }; $device = $ids | Where-Object { $_ -match '^\d+\.\d+\.\d+\.\d+:\d+$' } | Select-Object -First 1; if(-not $device){ $device = $ids | Select-Object -First 1 }; if(-not $device){ throw 'No ADB device connected' }; $paths = '@sel(false, "|")'; $paths.Split('|') | ForEach-Object { if($_.Trim()) { adb -s $device push """$_""" /storage/emulated/0/Download/ } }`)
}
